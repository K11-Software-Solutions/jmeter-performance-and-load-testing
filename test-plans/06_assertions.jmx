          <hashTree/>
          <SizeAssertion guiclass="SizeAssertionGui" testclass="SizeAssertion" testname="Size Assertion: response under 20 KB">
            <stringProp name="Assertion.test_field">SizeAssertion.response_data</stringProp>
            <stringProp name="SizeAssertion.size">20000</stringProp>
            <intProp name="SizeAssertion.operator">4</intProp>
          </SizeAssertion>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 Assertion: totalPaid equals the sum of the monthly rows">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
            def json = new JsonSlurper().parseText(prev.getResponseDataAsString())
            def sum = json.byMonth.collect { it.paid as BigDecimal }.sum().setScale(2, java.math.RoundingMode.HALF_UP)
            def total = (json.totalPaid as BigDecimal).setScale(2, java.math.RoundingMode.HALF_UP)
            if (sum != total) {
                AssertionResult.setFailure(true)
                AssertionResult.setFailureMessage(&quot;totalPaid &quot; + total + &quot; does not match sum of months &quot; + sum)
            }</stringProp>
          </JSR223Assertion>
          <hashTree/>
        </hashTree>
