        <TestAction guiclass="TestActionGui" testclass="TestAction" testname="Pacing wait">
          <intProp name="ActionProcessor.action">1</intProp>
          <intProp name="ActionProcessor.target">0</intProp>
          <stringProp name="ActionProcessor.duration">0</stringProp>
        </TestAction>
        <hashTree>
          <JSR223Timer guiclass="TestBeanGUI" testclass="JSR223Timer" testname="JSR223 Timer: wait for the rest of the 2000 ms pacing window">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// A JSR223 Timer returns the delay in milliseconds.
            long pacing = 2000L
            long elapsed = System.currentTimeMillis() - (vars.get('iterStart') as long)
            vars.put('newIteration', 'true')
            return Math.max(0L, pacing - elapsed)</stringProp>
          </JSR223Timer>
          <hashTree/>
        </hashTree>
      </hashTree>
