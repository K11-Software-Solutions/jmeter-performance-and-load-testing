        <hashTree/>
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor: remember iteration start">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">// Runs before the first sampler of the iteration: store when this iteration started.
          if (vars.get('iterStart') == null || vars.get('newIteration') == 'true') {
              vars.put('iterStart', String.valueOf(System.currentTimeMillis()))
              vars.put('newIteration', 'false')
          }</stringProp>
        </JSR223PreProcessor>
        <hashTree/>
